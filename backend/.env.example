# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Primary Database (Local file storage, foreign keys & WAL mode enabled)
DATABASE_URL=sqlite+aiosqlite:///./learnforge.db

# ChromaDB Local Persistent Directory
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Local Uploads Directory
UPLOAD_DIR=./uploads

# Hybrid AI Architecture Configuration
# Local LLM: Ollama (Qwen) - Recommended: qwen2.5:3b for CPU/laptops, qwen2.5:7b for dedicated GPU
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:3b

# Cloud LLM: OpenAI (Optional / Advanced tasks)
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_LLM_PROVIDER=local

# Local Embeddings (Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
